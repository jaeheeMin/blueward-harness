{
  "_설명": "비밀처럼 보이는 값을 가리는 규칙(#1018). 서버 secrets_mask.py 가 읽는다. 브라우저 static/flow-logic.js 의 maskSecrets 도 같은 규칙이고, 시험(test_web_console_ui.py)이 두 쪽의 규칙과 결과를 맞춰 본다. 정규식은 JS·Python 이 같은 글로 읽는 모양만 쓴다.",
  "mask": "••••••••",
  "name": "[\\w.-]*(?:secret|password|passwd|pwd|token|api[_-]?key|apikey|access[_-]?key|private[_-]?key|credential)[\\w.-]*",
  "assign": "\\b(NAME)[\"']?\\s*[:=]\\s*(?:\"([^\"]+)\"|'([^']+)'|([^\\s\"']{3,}))",
  "placeholder": "^[•*x.\\-_<>…()\\[\\]{}#]+$|^<.*>$|^\\(생략\\)$",
  "other": [
    {"label": "GitHub 토큰", "pattern": "\\bgh[pousr]_[A-Za-z0-9]{20,}"},
    {"label": "GitHub 토큰", "pattern": "\\bgithub_pat_[A-Za-z0-9_]{20,}"},
    {"label": "AWS 키", "pattern": "\\bAKIA[0-9A-Z]{16}\\b"},
    {"label": "API 키", "pattern": "\\bsk-[A-Za-z0-9_-]{16,}"},
    {"label": "Slack 토큰", "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}"},
    {"label": "개인 키", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----(?:[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----|[\\s\\S]*)"},
    {"label": "JWT", "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"},
    {"label": "Bearer 토큰", "pattern": "\\bBearer\\s+[A-Za-z0-9._~+/-]{16,}", "ignore_case": true},
    {"label": "주소에 든 비밀번호", "pattern": "://[^/\\s:@]+:[^/\\s@]{3,}@", "url_password": true}
  ]
