    "diff": ["--cached", "--staged", "--stat(=\\d+(,\\d+)*)?", "--shortstat", "--numstat", "--name-only", "--name-status", "--no-color", "--color(=\\w+)?", "-p", "--patch", "-U\\d+", "--unified=\\d+", "-w", "--ignore-all-space", "--ignore-space-change", "-b", "--check", "--summary", "--no-ext-diff", "--no-textconv", "--minimal", "--diff-filter=\\w+", "--exit-code", "--quiet", "--"],
    "log": ["--oneline", "--graph", "--decorate", "--stat", "--name-only", "--name-status", "--no-color", "--abbrev-commit", "--all", "--no-merges", "--merges", "--first-parent", "--reverse", "-n", "-n\\d+", "-\\d+", "--max-count=\\d+", "--since=.+", "--until=.+", "--author=.+", "--grep=.+", "--format=.+", "--pretty=.+", "--date=.+", "--follow", "-p", "--patch", "--no-ext-diff", "--"],
    "show": ["--stat", "--name-only", "--name-status", "--no-color", "--oneline", "--format=.+", "--pretty=.+", "-s", "--no-patch", "-p", "--patch", "-U\\d+", "--no-ext-diff", "--"],
    "rev-parse": ["--show-toplevel", "--abbrev-ref", "--short(=\\d+)?", "--verify", "-q", "--quiet", "--is-inside-work-tree", "--symbolic-full-name", "--git-dir", "--absolute-git-dir", "--show-prefix", "--show-cdup", "--"],
    "ls-files": ["-c", "-m", "-o", "-s", "-d", "-z", "-i", "--cached", "--modified", "--others", "--stage", "--deleted", "--ignored", "--exclude-standard", "--full-name", "--"],
    "rev-list": ["--count", "--max-count=\\d+", "-n", "-n\\d+", "--all", "--no-merges", "--merges", "--first-parent", "--reverse", "--oneline", "--left-right", "--"],
    "ls-tree": ["-r", "-d", "-l", "--name-only", "--long", "--full-name", "-z", "--"],
    "blame": ["-L", "-L\\S+", "-w", "--porcelain", "--line-porcelain", "-s", "-l", "--"],
    "merge-base": ["--is-ancestor", "--fork-point", "-a", "--all"],
    "describe": ["--tags", "--abbrev=\\d+", "--always", "--dirty", "--long"],
