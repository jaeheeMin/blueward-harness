  "bash_read": {
    "ls": {"paths": true, "options": ["-[laAhtrSdF1]+", "--color(=\\w+)?", "--all", "--almost-all", "--human-readable"]},
    "dir": {"paths": true, "options": ["--color(=\\w+)?"]},
    "cat": {"paths": true, "options": ["-[nbsAETv]+", "--number", "--squeeze-blank"]},
    "head": {"paths": true, "value_options": ["-n", "-c"], "options": ["-n\\d*", "-c\\d*", "-\\d+", "-q", "-v"]},
    "tail": {"paths": true, "value_options": ["-n", "-c"], "options": ["-n\\d*", "-c\\d*", "-\\d+", "-q", "-v"]},
    "wc": {"paths": true, "options": ["-[lwcmL]+", "--lines", "--words", "--bytes", "--chars"]},
    "grep": {"paths": true, "pattern_first": true, "value_options": ["-A", "-B", "-C", "-m", "-e"], "options": ["-[niIvlLcwxEFHhoqsaP]+", "-[ABCm]\\d+", "-[ABCm]", "-e", "--include=.+", "--exclude=.+", "--exclude-dir=.+", "--color(=\\w+)?", "--line-number", "--ignore-case", "--count", "--files-with-matches", "--no-messages", "--word-regexp", "--fixed-strings", "--extended-regexp", "--invert-match", "--max-count=\\d+"]},
    "rg": {"paths": true, "pattern_first": true, "needs_path": true, "no_dir_args": true, "value_options": ["-A", "-B", "-C", "-m", "-g", "-t", "-T"], "options": ["-[niIlcwxFvSsH]+", "-[ABCm]\\d+", "-[ABCmgtT]", "--glob=.+", "--type=.+", "--type-not=.+", "--max-count=\\d+", "--color=\\w+", "--no-heading", "--heading", "--line-number", "--ignore-case", "--smart-case", "--word-regexp", "--fixed-strings", "--invert-match", "--count", "--files-with-matches"]},
    "find": {"paths": true, "value_options": ["-name", "-iname", "-path", "-ipath", "-type", "-maxdepth", "-mindepth", "-mtime", "-mmin", "-size"], "options": ["-name", "-iname", "-path", "-ipath", "-type", "-maxdepth", "-mindepth", "-mtime", "-mmin", "-size", "-empty", "-not", "-and", "-or", "-print", "-print0", "-prune"]},
    "cut": {"paths": true, "value_options": ["-d", "-f", "-c", "-b"], "options": ["-[dfcb]\\S*", "-s", "--complement", "--delimiter=.+", "--fields=.+", "--characters=.+", "--only-delimited"]},
    "tr": {"paths": false, "options": ["-[dscCt]+"]},
    "sort": {"paths": true, "value_options": ["-k", "-t"], "options": ["-[nrufbhVdgMz]+", "-[kt]\\S*", "--numeric-sort", "--reverse", "--unique", "--ignore-case"]},
    "uniq": {"paths": true, "max_positional": 1, "options": ["-[cduiz]+", "-[fsw]\\d+", "--count", "--repeated", "--unique", "--ignore-case"]}
  },
  "sed_script": "\\d+(,\\d+)?p",
  "bash_delete_commands": ["rm", "del", "erase", "rd", "rmdir", "remove-item", "ri", "shred"],
  "bash_install_commands": ["winget", "choco", "scoop", "brew", "apt", "apt-get"],
  "git_value_options": ["-m", "-n", "-L"],
  "git_read_options": {
