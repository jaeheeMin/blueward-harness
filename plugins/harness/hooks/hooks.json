{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_write_guard.py\" || { echo \"doc-guard: 훅을 실행할 수 없어 문서를 검사하지 못했다. uv 가 설치되어 있는지 확인한다. 검사하지 못한 상태로 통과시키지 않는다. 다음: 사람이 할 일 - PowerShell 에서 winget install --id astral-sh.uv -e 로 uv 를 설치하고 Claude Code 를 새로 여십시오.\" >&2; exit 2; }",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-bash-git-guard.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*__(setObjectSource|renamePreview|renameExecute|extractMethodPreview|extractMethodExecute|createObject|deleteObject|activateObjects|activateByName|createTransport|transportRelease|transportDelete|publishServiceBinding|unPublishServiceBinding|runClass|gitPullRepo|pushRepo|tableContents|runQuery)",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"${CLAUDE_PLUGIN_ROOT}/hooks/mcp_source_guard.py\" || { echo \"harness: 훅을 실행할 수 없어 MCP 쓰기를 검사하지 못했다. uv 가 설치되어 있는지 확인한다. 검사하지 못한 상태로 통과시키지 않는다. 다음: 사람이 할 일 - PowerShell 에서 winget install --id astral-sh.uv -e 로 uv 를 설치하고 Claude Code 를 새로 여십시오.\" >&2; exit 2; }",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start-sync.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-deliver.sh\""
          }
        ]
      }
    ]
  }
}
